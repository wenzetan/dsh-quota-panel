# 中国本地网络示例。按需复制为 testbed/.env；不要提交 .env。
# CHINA_* 只作用于 China 模式，不会污染 global / CI reproduction。
CHINA_NODE_IMAGE=docker.m.daocloud.io/library/node:24-bookworm-slim
CHINA_NPM_REGISTRY=https://registry.npmmirror.com
# slim 基础层用 HTTP 引导安装 CA；apt 仍校验仓库签名。两个 apt mirror 必须成对设置。
CHINA_APT_MIRROR=http://mirrors.aliyun.com/debian
CHINA_APT_SECURITY_MIRROR=http://mirrors.aliyun.com/debian-security

# 代理是可选项。只在本地 .env 或进程环境中填值，禁止提交凭据。
# CHINA_HTTP_PROXY=
# CHINA_HTTPS_PROXY=
# CHINA_NO_PROXY=localhost,127.0.0.1,host.docker.internal
