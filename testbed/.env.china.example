# 中国本地网络示例。按需复制为 testbed/.env；不要提交 .env。
NODE_IMAGE=docker.m.daocloud.io/library/node:24-bookworm-slim
NPM_REGISTRY=https://registry.npmmirror.com
# slim 基础层用 HTTP 引导安装 CA；apt 仍校验仓库签名。已有 CA 的自定义基础镜像可改 HTTPS。
APT_MIRROR=http://mirrors.aliyun.com/debian

# 代理是可选项。只在本地 .env 或进程环境中填值，禁止提交凭据。
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=localhost,127.0.0.1,host.docker.internal
